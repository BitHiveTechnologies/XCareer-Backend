<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your account credentials</title>
</head>
<!-- Styles are inline throughout: Gmail drops <style> blocks and overrides link
     colours set by class, which is what made buttons unreadable in other templates. -->
<body style="margin:0;padding:0;background-color:#f1f5f9;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background-color:#ffffff;border-radius:12px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif;">

          <tr>
            <td style="background-color:#0ea5e9;padding:32px;">
              <p style="margin:0 0 6px 0;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#e0f2fe;">X Careers</p>
              <h1 style="margin:0;font-size:24px;line-height:1.3;color:#ffffff;font-weight:700;">Your account is ready</h1>
            </td>
          </tr>

          <tr>
            <td style="padding:32px 32px 0 32px;">
              <p style="margin:0 0 16px 0;font-size:16px;color:#0f172a;">Hi {{name}},</p>
              <p style="margin:0 0 24px 0;font-size:15px;line-height:1.6;color:#475569;">
                Thanks for subscribing{{#if plan}} to the <strong style="color:#0f172a;">{{plan}}</strong> plan{{/if}}. We've created an account for you — sign in with the details below to manage your subscription.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <p style="margin:0 0 4px 0;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;color:#64748b;">Email</p>
                    <p style="margin:0 0 18px 0;font-size:15px;color:#0f172a;">{{email}}</p>

                    <p style="margin:0 0 4px 0;font-size:12px;letter-spacing:0.5px;text-transform:uppercase;color:#64748b;">Temporary password</p>
                    <p style="margin:0;font-size:18px;font-family:'SF Mono',Menlo,Consolas,monospace;letter-spacing:0.5px;color:#0f172a;font-weight:600;">{{password}}</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:28px 32px 6px 32px;">
              <a href="{{loginUrl}}" style="display:inline-block;background-color:#0ea5e9;color:#ffffff !important;padding:14px 36px;text-decoration:none;border-radius:8px;font-size:16px;font-weight:600;">Log in to your account</a>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:0 32px 24px 32px;">
              <p style="margin:0;font-size:13px;color:#94a3b8;">Or open {{loginUrl}}</p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 32px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fffbeb;border-left:4px solid #f59e0b;border-radius:6px;">
                <tr>
                  <td style="padding:14px 18px;">
                    <p style="margin:0;font-size:14px;line-height:1.6;color:#92400e;">
                      Keep this password safe. You can change it any time from your profile settings.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:24px 32px 32px 32px;">
              <p style="margin:0;font-size:14px;line-height:1.6;color:#475569;">
                Any questions? Just reply to this email and we'll help.
              </p>
            </td>
          </tr>

          <tr>
            <td style="background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;">
              <p style="margin:0;font-size:12px;line-height:1.5;color:#94a3b8;">
                &copy; 2026 X Careers Connect Private Limited. All rights reserved.<br>
                You're receiving this because an account was created for {{email}}.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
